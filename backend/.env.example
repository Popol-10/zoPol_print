NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=makart
MYSQL_USER=makart
MYSQL_PASSWORD=change-me

# Utiliser des valeurs longues, aléatoires et distinctes en production.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-characters
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL_MINUTES=30
RESET_PASSWORD_URL=http://localhost:8080/reinitialiser-mot-de-passe

# E-mail transactionnel SMTP (Brevo, Gmail avec mot de passe d’application, Mailgun, etc.).
# Activez SMTP_ENABLED puis renseignez vos valeurs locales, sans commiter de secret.
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM="MAK'ART <no-reply@example.com>"
